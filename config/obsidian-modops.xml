  </ModOp>
  <ModOp GUID="144837" Replace="VolcanoPhase/SpawnLimitedLodeFertilities/Item[LimitedLodeFertility='145337']/TechIncreaseAmountMax">
    <TechIncreaseAmountMax>400</TechIncreaseAmountMax>
  </ModOp>
</ModOps>
